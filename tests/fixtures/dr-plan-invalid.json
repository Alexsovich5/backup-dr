{
  "name": "Broken-Plan",
  "rpoThresholdMinutes": 0,
  "azure": { "vaultName": "rsv-dr", "recoveryPlan": "rp-primary" },
  "failoverSteps": [
    { "name": "Fail over DB replica", "type": "veeam_replica" },
    { "name": "Restore from tape", "type": "tape_restore", "target": "lib-01" },
    { "name": "Point app DNS at DR", "type": "dns_update", "zone": "example.local",
      "record": "app", "primaryIp": "10.10.0.10" },
    { "name": "Notify IT", "type": "notification", "to": "it-admin@example.local" },
    { "name": "Notify IT", "type": "notification", "to": "dr-team@example.local" }
  ]
}
